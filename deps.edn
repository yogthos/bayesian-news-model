{:jolt/min-version "0.8.16"

 ;; The library has no dependencies: the model is plain EDN data, and the
 ;; host (newsroom) persists it however it likes.
 :paths ["src" "resources"]

 :aliases
 {:test {:extra-paths ["test" "tools"]
         :extra-deps {io.github.jlt-commons/dodeca {:git/url "https://github.com/jlt-commons/dodeca"
                                                    :git/tag "v0.1.0"
                                                    :git/sha "20b01f749d8789ae5d6a6756649a2278d240199d"}}
         :main-opts ["-m" "bnm.test-runner"]}
  ;; ingestion, training and backtesting over data/ (see README)
  :tools {:extra-paths ["tools"]
          ;; A5 equal-area cells for event coordinates
          :extra-deps {io.github.jlt-commons/dodeca {:git/url "https://github.com/jlt-commons/dodeca"
                                                     :git/tag "v0.1.0"
                                                     :git/sha "20b01f749d8789ae5d6a6756649a2278d240199d"}}}}}
