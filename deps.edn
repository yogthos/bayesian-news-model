{:jolt/min-version "0.8.16"

 ;; The model is plain EDN data, and the host (newsroom) persists it however
 ;; it likes. Its statistics come from augur, which has no dependencies.
 ;; Space is A5 equal-area cells (dodeca, docs/PRINCIPLES.md 11).
 :paths ["src" "resources"]
 :deps {io.github.jlt-commons/augur {:git/url "https://github.com/jlt-commons/augur"
                                     :git/tag "v0.10.0"
                                     :git/sha "6bd68051632d264ee84e9d32596aa49c197633d6"}
        io.github.jlt-commons/dodeca {:git/url "https://github.com/jlt-commons/dodeca"
                                      :git/tag "v0.1.0"
                                      :git/sha "20b01f749d8789ae5d6a6756649a2278d240199d"}}

 :aliases
 {:test {:extra-paths ["test" "tools"]
         :main-opts ["-m" "bnm.test-runner"]}
  ;; ingestion, training and backtesting over data/ (see README)
  :tools {:extra-paths ["tools"]}}}
