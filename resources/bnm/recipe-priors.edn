  :ipcc-ncv "IPCC (2006). Guidelines for National Greenhouse Gas Inventories, vol. 2, table 1.2 (net calorific values; as bnm.supply/ncv)."
  :cassman "Cassman, K.G., Dobermann, A. & Walters, D.T. (2002). Agroecosystems, nitrogen-use efficiency, and nitrogen management. Ambio 31(2):132-140. https://doi.org/10.1579/0044-7447-31.2.132"
  :lassaletta "Lassaletta, L., Billen, G., Grizzetti, B., Anglade, J. & Garnier, J. (2014). 50 year trends in nitrogen use efficiency of world cropping systems. Environmental Research Letters 9:105011. https://doi.org/10.1088/1748-9326/9/10/105011"
  :heffer "Heffer, P., Gruere, A. & Roberts, T. (2017). Assessment of Fertilizer Use by Crop at the Global Level 2014-2014/15. IFA and IPNI, Paris."
  :cordell "Cordell, D., Drangert, J.-O. & White, S. (2009). The story of phosphorus. Global Environmental Change 19(2):292-305. https://doi.org/10.1016/j.gloenvcha.2008.10.009"
  :smil "Smil, V. (2001). Enriching the Earth. MIT Press."
  :xu "Xu, C., Dai, Q., Gaines, L., Hu, M., Tukker, A. & Steubing, B. (2020). Future material demand for automotive lithium-based batteries. Communications Materials 1:99. https://doi.org/10.1038/s43246-020-00095-x"
  :usgs-iron "USGS Mineral Commodity Summaries, Iron Ore (yearly): China's production is reported as crude ore; its usable ore is about a quarter to a third of it."
  :icsg "ICSG (yearly). The World Copper Factbook: secondary (scrap) refined copper is about 15-18% of refined output."
  :iai "International Aluminium Institute statistics (yearly): primary aluminium smelting power consumption; alumina production by use."}

 :recipes
 [;; ------------------------------------------------------------ ammonia
  {:id "ammonia/gas"
   :group "fertiliser"
   :unit "t natural gas (48.0 GJ/t net) per t NH3, steam methane reforming (feed and fuel)"
   :mean 0.67 :lo 0.58 :hi 0.80
   :floor 0.43 :floor-basis "about 20.6 GJ/t: NH3's LHV of 18.6 GJ/t plus the separation work (IEA 2021), at 48 GJ/t"
   :step 0.02 :ref-year 2011
   :regions :exio-all :exclude ["CN"]
   :sources [{:kind :exio-ammonia :route :gas :sd0 0.25
              :price {:out ["310210" "281410"] :in ["271121" "271111"]}}]
   :cite [:iea-ammonia :worrell :smil]
   :note "Best practice about 28 GJ/t; average gas plants 32-36 (section 4)."}
  {:id "ammonia/coal"
   :group "fertiliser"
   :unit "t coal (25.8 GJ/t net, other bituminous) per t NH3, coal gasification (feed and fuel)"
   :mean 1.94 :lo 1.74 :hi 2.13
   :floor 0.80 :floor-basis "the same 20.6 GJ/t minimum at 25.8 GJ/t"
   :step 0.02 :ref-year 2011
   :regions ["CN"]
   :sources [{:kind :exio-ammonia :route :coal :sd0 0.25
              :price {:out ["310210" "281410"] :in ["270112"]}}]
